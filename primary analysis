```{r}
# MODEL COMPARISON: Compares all 6 models on the same 5-fold MSE scale.

# 6A. Collect results from all 6 caret models
caret_cv <- resamples(list(
  OLS = ols_model,
  Ridge = ridge_model,
  LASSO = lasso_model,
  ElasticNet = enet_model,
  SingleTree = tree_model,
  RandomForest = rf_model
))

# 6B. MSE Comparison
cv_long <- caret_cv$values %>%
  select(-Resample) %>%
  pivot_longer(everything(), names_to = "key", values_to = "value") %>%
  filter(grepl("RMSE", key)) %>%
  mutate(value = value^2,
         Model = str_remove(key, "~RMSE"))

ggplot(cv_long, aes(x = reorder(Model, value, median),
                    y = value, fill = Model)) +
  geom_boxplot(outlier.shape = 21, show.legend = FALSE) +
  coord_flip() +
  labs(title = "5-Fold CV MSE by Model (log-price scale)", y = "MSE") +
  theme_minimal()
 
# 6C. R-squared comparison
r2_long <- caret_cv$values %>%
  select(-Resample) %>%
  pivot_longer(everything(), names_to = "key", values_to = "value") %>%
  filter(grepl("Rsquared", key)) %>%
  mutate(Model = str_remove(key, "~Rsquared"))
 
ggplot(r2_long, aes(x = reorder(Model, value, median),
                    y = value, fill = Model)) +
  geom_boxplot(outlier.shape = 21, show.legend = FALSE) +
  coord_flip() +
  labs(title = "5-Fold R-Squared by Model", y = "R-Squared") +
  theme_minimal()
 
# 6D. Summary Table
cv_rmse_summary <- summary(caret_cv)$statistics$RMSE
cv_summary <- cv_rmse_summary^2
cat("\nModel CV MSE comparison:\n")
print(round(cv_summary[, c("Mean", "Min.", "Max.")], 4))
```

```{r}
# PREDICTIONS AND DIAGNOSTIC TESTS

# 7A. Identify best model by mean CV MSE
best_name <- rownames(cv_rmse_summary)[which.min(cv_rmse_summary[, "Mean"])]
cat("Best model by mean CV MSE:", best_name,
    "MSE:", round(cv_summary[best_name, "Mean"], 4), "\n")
 
model_lookup <- list(
  OLS = ols_model,
  Ridge = ridge_model,
  LASSO = lasso_model,
  ElasticNet = enet_model,
  SingleTree = tree_model,
  RandomForest = rf_model
)
best_model <- model_lookup[[best_name]]
 
# 7B. Generate test predictions
if (best_name %in% c("RandomForest", "SingleTree")) {
  log_preds <- predict(best_model, newdata = X_test_df)
} else {
  log_preds <- predict(best_model, newdata = X_mat_test)
}

# reverse log transform to USD 
price_preds <- exp(log_preds)   
 
cat("Predicted price range: $", round(min(price_preds), 2),
    "to $", round(max(price_preds), 2), "\n")
cat("Predicted price mean:  $", round(mean(price_preds), 2), "\n")
 
ggplot(data.frame(price = price_preds), aes(x = price)) +
  geom_histogram(bins = 50, fill = "steelblue", color = "white") +
  labs(title = "Distribution of Predicted Test Prices",
       x = "Predicted Price (USD)", y = "Count") +
  theme_minimal()

# 7C. Diagnostic plots on training set
if (best_name %in% c("RandomForest", "SingleTree")) {
  train_preds <- predict(best_model, newdata = X_train_df)
} else {
  train_preds <- predict(best_model, newdata = X_mat_train)
}
 
resid_df <- data.frame(
  fitted   = train_preds,
  residual = y_train - train_preds
)
 
# Residuals vs Fitted
ggplot(resid_df, aes(x = fitted, y = residual)) +
  geom_point(alpha = 0.2, color = "steelblue") +
  geom_hline(yintercept = 0, color = "maroon", linetype = "dashed") +
  geom_smooth(method = "loess", color = "darkblue", se = TRUE) +
  labs(title = paste("Residuals vs Fitted:", best_name),
       x = "Fitted log(Price)", y = "Residual") +
  theme_minimal()
 
# Actual vs Predicted in USD
ggplot(data.frame(actual = exp(y_train),
                  predicted = exp(train_preds)),
       aes(x = actual, y = predicted)) +
  geom_point(alpha = 0.2, color = "steelblue") +
  geom_abline(slope = 1, intercept = 0, color = "maroon",
              linetype = "dashed", linewidth = 0.8) +
  labs(title = paste("Actual vs Predicted Price:", best_name),
       x = "Actual Price (USD)", y = "Predicted Price (USD)") +
  theme_minimal()
